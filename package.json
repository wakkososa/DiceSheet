{
  "name": "dicesheet",
  "version": "0.1.18b",
  "description": "DiceSheet: a lightweight character sheet compatible with DiceCloud libraries and character files",
  "scripts": {
    "build:harness": "node build.mjs harness/compat.ts",
    "test:compat": "node build.mjs harness/compat.ts && node dist/compat.js",
    "test:roundtrip": "node harness/roundtrip.mjs",
    "build": "node build.mjs src/server/main.ts && vite build --config web/vite.config.ts",
    "start": "node dist/main.js",
    "dev:web": "vite --config web/vite.config.ts",
    "test": "node test/e2e.mjs"
  },
  "author": "",
  "license": "GPL-3.0",
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.0",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^6.4.4"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.10",
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/alegreya-sans": "^5.3.0",
    "@hono/node-server": "^2.1.4",
    "alea": "^1.0.1",
    "dompurify": "^3.4.16",
    "hono": "^4.13.13",
    "lodash": "^4.18.1",
    "marked": "^12.0.2",
    "moo": "^0.5.3",
    "nearley": "^2.20.1",
    "ngraph.graph": "^20.1.2",
    "ngraph.path": "^1.6.1",
    "sift": "^17.1.4",
    "simpl-schema": "^1.13.1",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4"
  },
  "type": "module"
}
